# dmesh coordinator configuration (copy to .env and fill in)

APP_ADDR=:8080
DB_PATH=data/dmesh.db

# Stellar testnet
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Deployed settlement contract (C... address). Current testnet v2 deployment
# (spend-hold enabled): CD3CYW3VGVCQBQUPLQTTWJPLYB6DNARFQBOSFLTK2B55XWLJDDVDBMMK
SETTLEMENT_CONTRACT_ID=CD3CYW3VGVCQBQUPLQTTWJPLYB6DNARFQBOSFLTK2B55XWLJDDVDBMMK

# Admin Stellar secret seed (S...). Used only for contract administration
# (tier / oracle-price updates). It never custody-creates user funds.
ADMIN_STELLAR_SECRET=

# Note: geo/tier classification runs in the node CLI, not in this daemon.
# Nodes consume the GeoLite2 files published by the geo-db-refresh workflow.

# Dashboard JWT and email OTP (dashboard only; nodes use key signatures)
JWT_SECRET=change-me-to-a-long-random-string
OTP_TTL_MINUTES=10
DEV_OTP_CODES=true

# SMTP relay (Cloudflare Email Routing SMTP works with its own credentials)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@dmesh.network

# Session and liveness
SESSION_TTL_MINUTES=60
HEARTBEAT_TIMEOUT_MINUTES=5
MAX_BANDWIDTH_BPS=1500000000
