---
import Logo from './Logo.astro';
---

<section id="top" class="hero">
  <div class="wrap">
    <div class="mark"><Logo size={64} /></div>
    <h1>Web access for AI agents and scrapers, settled per byte.</h1>
    <p class="lead">
      dmesh gives agents and data pipelines pay-per-request access to the web through
      community-run nodes. Traffic flows directly between peers and is metered into a
      Soroban smart contract on Stellar — no subscriptions, no central API keys, no
      trusted middleman holding funds.
    </p>
    <div class="cta">
      <a class="btn btn-primary" href="#download">Download the CLI</a>
      <a class="btn btn-ghost" href="#network">Live network</a>
    </div>
  </div>
</section>

<style>
  .hero {
    text-align: center;
    padding: 110px 0 90px;
    background:
      radial-gradient(1200px 480px at 50% -120px, rgba(43, 182, 255, 0.12), transparent),
      #fff;
  }
  .mark {
    margin-bottom: 22px;
  }
  h1 {
    font-size: clamp(34px, 6vw, 60px);
    font-weight: 700;
    line-height: 1.08;
    max-width: 820px;
    margin: 0 auto 18px;
  }
  .lead {
    font-size: clamp(17px, 2.2vw, 21px);
    color: var(--ink-soft);
    max-width: 680px;
    margin: 0 auto 32px;
  }
  .cta {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
