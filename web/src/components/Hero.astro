---
import Logo from './Logo.astro';
---

<section id="top" class="hero">
  <div class="wrap">
    <div class="mark"><Logo size={64} /></div>
    <h1>Bandwidth, settled with code rather than trust.</h1>
    <p class="lead">
      dmesh connects clients and exit nodes for private networking and a metered
      agent API. Every session is settled by a Soroban smart contract, in the Stellar
      assets each side already holds.
    </p>
    <div class="cta">
      <a class="btn btn-primary" href="#download">Download</a>
      <a class="btn btn-ghost" href="#network">Live network</a>
    </div>
  </div>
</section>

<style>
  .hero {
    text-align: center;
    padding: 110px 0 90px;
    background:
      radial-gradient(1200px 480px at 50% -120px, rgba(43, 182, 255, 0.12), transparent),
      #fff;
  }
  .mark {
    margin-bottom: 22px;
  }
  h1 {
    font-size: clamp(34px, 6vw, 60px);
    font-weight: 700;
    line-height: 1.08;
    max-width: 820px;
    margin: 0 auto 18px;
  }
  .lead {
    font-size: clamp(17px, 2.2vw, 21px);
    color: var(--ink-soft);
    max-width: 680px;
    margin: 0 auto 32px;
  }
  .cta {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
